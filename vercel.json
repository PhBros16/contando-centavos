{
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
